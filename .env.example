# Copy to .env for local Docker development.
# Never commit the real .env file.
DB_PASSWORD=ReplaceWithAUniqueStrongDatabasePassword123!
JWT_SECRET_KEY=ReplaceWithAtLeast32RandomBytesForJwtSigning!
VAKTKLAR_BOOTSTRAP_KEY=ReplaceWithARandomOneTimeSetupKey!
# false is required for plain HTTP localhost development. Set true behind HTTPS in production.
SECURITY_COOKIE_SECURE=false
